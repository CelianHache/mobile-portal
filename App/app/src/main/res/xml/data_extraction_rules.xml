<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde cloud et transfert d'appareil (Android 12+). La clé d'API Tailscale reste sur l'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tailscale.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tailscale.xml" />
    </device-transfer>
</data-extraction-rules>
